diff --git a/main/abstract_jb.c b/main/abstract_jb.c
index 6fda9dfb9d..0a58fbf4ed 100644
--- a/main/abstract_jb.c
+++ b/main/abstract_jb.c
@@ -1284,6 +1284,15 @@ void ast_jb_create_framehook(struct ast_channel *chan, struct ast_jb_conf *jb_co
 			ast_framehook_detach(chan, *id);
 			ast_channel_datastore_remove(chan, datastore);
 			ast_datastore_free(datastore);
+			/*
+			 * The framehook destroy is deferred until the next frame passes through;
+			 * at that point jb_framedata_destroy() closes the timer fd.  If the
+			 * channel enters any poll-based wait (BridgeWait, Wait(), etc.) between
+			 * here and that deferred destroy, poll() will see the closed fd and
+			 * return POLLNVAL immediately on every call, pinning the thread at 100%
+			 * CPU.  Clear the channel fd slot now so poll() skips it entirely.
+			 */
+			ast_channel_set_fd(chan, AST_JITTERBUFFER_FD, -1);
 		}
 		ast_channel_unlock(chan);
 		return;
